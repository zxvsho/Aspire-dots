[
  {
    "name": "isla",
    "layer": "top",
    "position": "top",
    "height": 42,
    "width": 360,
    "exclusive": false,
    "passthrough": false,
    "margin-top": 10,
    "modules-left": [],
    "modules-center": ["group/island"],
    "modules-right": [],
    "group/island": {
      "orientation": "horizontal",
      "modules": ["custom/island-trigger", "ext/workspaces", "mpris", "clock"],
      "drawer": {
        "transition-duration": 250,
        "transition-left-to-right": false,
        "children-class": "island-child"
      }
    },
    "custom/island-trigger": {
      "format": "󰟵",
      "tooltip": false
    },
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-up": "mmsg dispatch workspace +1",
      "on-scroll-down": "mmsg dispatch workspace -1"
    },
    "mpris": {
      "format": "{player_icon} {title}",
      "max-length": 24,
      "interval": 2
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A %d %B %Y}"
    }
  }
]
