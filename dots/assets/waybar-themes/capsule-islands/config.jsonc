[
  {
    "name": "capsule-islands",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,
    "margin-top": 7,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "battery", "tray"],
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-up": "mmsg dispatch workspace +1",
      "on-scroll-down": "mmsg dispatch workspace -1"
    },
    "clock": {
      "format": "󰥔 {:%H:%M}",
      "tooltip-format": "{:%A %d %B %Y}"
    },
    "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": ["󰕿", "󰖀", "󰕾"]
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "states": {"warning": 20, "critical": 10}
    },
    "tray": {"spacing": 8, "icon-size": 14}
  }
]
