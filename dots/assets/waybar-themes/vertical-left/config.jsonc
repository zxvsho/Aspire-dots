[
  {
    "name": "vertical-left",
    "layer": "top",
    "position": "left",
    "width": 54,
    "spacing": 4,
    "modules-left": ["ext/workspaces", "clock"],
    "modules-center": [],
    "modules-right": ["pulseaudio", "battery", "tray"],
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-up": "mmsg dispatch workspace +1",
      "on-scroll-down": "mmsg dispatch workspace -1"
    },
    "clock": {"format": "{:%H\\n%M}", "tooltip-format": "{:%A %d %B %Y}"},
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "󰝟",
      "format-icons": ["󰕿", "󰖀", "󰕾"]
    },
    "battery": {
      "format": "{icon}",
      "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "states": {"warning": 20, "critical": 10}
    },
    "tray": {"spacing": 4, "icon-size": 14}
  }
]
