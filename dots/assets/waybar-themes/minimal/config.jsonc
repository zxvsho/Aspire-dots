[
  {
    "name": "minimal",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,
    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "custom/power"],
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-up": "mmsg dispatch workspace +1",
      "on-scroll-down": "mmsg dispatch workspace -1"
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A %d %B %Y}"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": ["󰕿", "󰖀", "󰕾"]
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "wlogout",
      "tooltip": false
    }
  }
]
