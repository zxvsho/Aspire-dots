# ==================== INSTALL ====================
[levels.install]
prompt = "Install"
data = "install"
parent = "root"
items = [
  { type = "action", label = "Packages", icon = "󰏓", action = "install_packages" },
  { type = "action", label = "Fonts", icon = "󰛖", action = "install_fonts" },
  { type = "action", label = "Themes", icon = "󰏘", action = "install_themes" },
  { type = "action", label = "Store", icon = "󰏓", action = "install_store" },
