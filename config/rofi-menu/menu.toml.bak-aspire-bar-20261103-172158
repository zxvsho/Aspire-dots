# aspire-menu - Declarative menu definition matching rofi-menu.sh
# Structure: level_id = { prompt, parent, items = [{type, label, action, ...}] }
# Types: "submenu", "action", "toggle"

[metadata]
version = "1.0"
default_level = "root"

[levels.root]
prompt = "Go"
data = "root"
parent = ""
items = [
  { type = "action", label = "Apps", icon = "󰀻", action = "apps_launcher" },
  { type = "submenu", label = "Settings", icon = "󰒓", target = "settings" },
  { type = "submenu", label = "Style", icon = "󰏘", target = "style" },
  { type = "submenu", label = "Utils", icon = "󰖷", target = "utils" },
  { type = "submenu", label = "Install", icon = "󰇚", target = "install" },
  { type = "submenu", label = "Remove", icon = "󰆴", target = "remove" },
  { type = "submenu", label = "Update", icon = "󰑐", target = "update" },
  { type = "submenu", label = "Extras", icon = "󰩦", target = "extras" },
  { type = "submenu", label = "System", icon = "󰪫", target = "system" },
]

# ==================== SETTINGS ====================
[levels.settings]
prompt = "Settings"
data = "settings"
parent = "root"
items = [
  { type = "action", label = "Monitors", icon = "󰍹", action = "settings_monitors" },
  { type = "action", label = "Keyboard", icon = "󰌌", action = "settings_keyboard" },
  { type = "action", label = "Bluetooth", icon = "󰂯", action = "settings_bluetooth" },
  { type = "action", label = "Network", icon = "󰈀", action = "settings_network" },
]

# ==================== STYLE ====================
[levels.style]
prompt = "Style"
data = "style"
parent = "root"
items = [
  { type = "submenu", label = "Background", icon = "󰋩", target = "background" },
  { type = "submenu", label = "Engine", icon = "󰈊", target = "engine" },
  { type = "submenu", label = "Theme", icon = "󰢵", target = "theme" },
  { type = "submenu", label = "Launcher", icon = "󰑣", target = "launcher" },
  { type = "submenu", label = "Powermenu", icon = "󰐥", target = "powermenu" },
  { type = "submenu", label = "Menu Bar", icon = "󰕰", target = "menubar" },
  { type = "submenu", label = "Font", icon = "󰛖", target = "font" },
  { type = "submenu", label = "Custom", icon = "󰘮", target = "custom" },
]

[levels.background]
prompt = "Background"
data = "background"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰉏", action = "bg_selector" },
  { type = "action", label = "Aleatorio", icon = "󰸉", action = "bg_random" },
  { type = "action", label = "Recolorear", icon = "󰸋", action = "bg_colors" },
  { type = "action", label = "Tema base16…", icon = "󰓡", action = "bg_tinty_base16" },
  { type = "action", label = "Tema base24…", icon = "󰓡", action = "bg_tinty_base24" },
]

[levels.engine]
prompt = "Engine"
data = "engine"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰓡", action = "engine_selector" },
  { type = "toggle", label = "Dynamic Color", icon = "󰃣", action = "engine_matugen", state_key = "color_engine", state_on = "matugen" },
  { type = "toggle", label = "Theme Managers", icon = "󰓡", action = "engine_tinty", state_key = "color_engine", state_on = "tinty" },
]

[levels.theme]
prompt = "Theme"
data = "theme"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰓡", action = "theme_selector" },
  { type = "action", label = "Apply", icon = "󰗼", action = "theme_apply" },
  { type = "submenu", label = "Custom Themes", icon = "󰏘", target = "theme_custom" },
]

[levels.theme_custom]
prompt = "Custom Themes"
data = "theme-custom"
parent = "theme"
items = [
  { type = "action", label = "Create New…", icon = "󰏘", action = "theme_create" },
]

[levels.launcher]
prompt = "Launcher"
data = "launcher"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰀻", action = "launcher_selector" },
  { type = "action", label = "Apply", icon = "󰗼", action = "launcher_apply" },
]

[levels.powermenu]
prompt = "Powermenu"
data = "powermenu"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰏘", action = "powermenu_selector" },
  { type = "action", label = "Apply", icon = "󰗼", action = "powermenu_apply" },
]

[levels.menubar]
prompt = "Menu Bar"
data = "menubar"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰕮", action = "menubar_selector" },
  { type = "action", label = "Apply", icon = "󰗼", action = "menubar_apply" },
]

[levels.font]
prompt = "Font"
data = "font"
parent = "style"
items = [
  { type = "action", label = "Selector", icon = "󰛖", action = "font_selector" },
  { type = "action", label = "Preview", icon = "󰽡", action = "font_preview" },
]

[levels.custom]
prompt = "Custom"
data = "custom"
parent = "style"
items = [
  { type = "action", label = "Colors", icon = "󰏘", action = "custom_colors" },
  { type = "action", label = "CSS", icon = "󰏘", action = "custom_css" },
  { type = "action", label = "Create Theme", icon = "󰏘", action = "custom_create_theme" },
]

# ==================== UTILS ====================
[levels.utils]
prompt = "Utils"
data = "utils"
parent = "root"
items = [
  { type = "action", label = "Screenshot", icon = "󰄄", action = "utils_screenshot" },
  { type = "action", label = "Clipboard", icon = "󰅇", action = "utils_clipboard" },
  { type = "action", label = "Color Picker", icon = "󰏘", action = "utils_color_picker" },
  { type = "action", label = "Calculator", icon = "󰃬", action = "utils_calculator" },
  { type = "action", label = "Emoji", icon = "󰏘", action = "utils_emoji" },
