  { type = "action", label = "Powermenu", icon = "󰐥", action = "system_powermenu" },
  { type = "action", label = "Lock", icon = "󰌾", action = "system_lock" },
  { type = "action", label = "Logout", icon = "󰍃", action = "system_logout" },
  { type = "action", label = "Reboot", icon = "󰑓", action = "system_reboot" },
  { type = "action", label = "Shutdown", icon = "󰐥", action = "system_shutdown" },
]

