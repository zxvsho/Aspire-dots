[
  {
    "position": "top",
    "layer": "top",
    "name": "capsule-islands",
    "height": 38,
    "spacing": 4,
    "margin-top": 7,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
      "ext/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "network",
      "pulseaudio",
      "battery",
      "tray"
    ],
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "states": {
        "critical": 10,
        "warning": 20
      }
    },
    "clock": {
      "format": "󰥔 {:%H:%M}",
      "tooltip-format": "{:%A %d %B %Y}"
    },
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-down": "mmsg dispatch workspace -1",
      "on-scroll-up": "mmsg dispatch workspace +1"
    },
    "network": {
      "format-disconnected": "󰤭",
      "format-ethernet": "󰈀",
      "format-wifi": "󰤨 {essid}"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "format-muted": "󰝟"
    },
    "tray": {
      "icon-size": 14,
      "spacing": 8
    }
  }
]
