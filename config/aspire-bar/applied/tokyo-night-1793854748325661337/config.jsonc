[
  {
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A %d %B %Y}"
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "wlogout",
      "tooltip": false
    },
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-down": "mmsg dispatch workspace -1",
      "on-scroll-up": "mmsg dispatch workspace +1"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "format-muted": "󰝟"
    },
    "name": "minimal",
    "position": "top",
    "layer": "top",
    "height": 28,
    "spacing": 4,
    "margin-top": null,
    "margin-left": null,
    "margin-right": null,
    "margin-bottom": null,
    "modules-left": [
      "ext/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "pulseaudio",
      "custom/power"
    ]
  }
]
