[
  {
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "states": {
        "critical": 10,
        "warning": 20
      }
    },
    "clock": {
      "format": "󰥔 {:%I:%M }",
      "interval": 60,
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "cpu": {
      "format": "{usage}%",
      "interval": 2,
      "on-click": ""
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "wlogout",
      "tooltip": false
    },
    "ext/workspaces": {
      "format": "{icon}",
      "ignore-hidden": true,
      "on-click": "mmsg dispatch workspace {index}",
      "on-scroll-down": "mmsg dispatch workspace -1",
      "on-scroll-up": "mmsg dispatch workspace +1"
    },
    "network": {
      "format-disconnected": "󰤭",
      "format-ethernet": "󰈀",
      "format-wifi": "󰤨 "
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "format-muted": "󰝟"
    },
    "tray": {
      "icon-size": 14,
      "spacing": 8
    },
    "name": "minimal",
    "position": "top",
    "layer": "top",
    "height": 38,
    "spacing": 4,
    "margin-top": null,
    "margin-left": null,
    "margin-right": null,
    "margin-bottom": null,
    "modules-left": [
      "ext/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "tray",
      "network",
      "pulseaudio",
      "cpu",
      "battery"
    ]
  }
]
